<?xml version="1.0" encoding="utf-8"?>
<!-- Google auto-backup (Android 11 and older): the main database and the small settings stores; not the notification history,
     the snapshots folder or caches. -->
<full-backup-content>
    <include domain="database" path="cashflow.db" />
    <include domain="sharedpref" path="settings_prefs.xml" />
    <include domain="sharedpref" path="notification_prefs.xml" />
    <include domain="sharedpref" path="ui_prefs.xml" />
    <exclude domain="database" path="notifications.db" />
    <exclude domain="database" path="notifications.db-wal" />
    <exclude domain="database" path="notifications.db-shm" />
    <exclude domain="file" path="backups" />
    <exclude domain="sharedpref" path="backup_state.xml" />
</full-backup-content>
